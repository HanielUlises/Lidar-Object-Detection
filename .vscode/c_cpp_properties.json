{
  "configurations": [
    {
      "name": "ROS",
      "includePath": [
        "${workspaceFolder}/**",
        "/opt/ros/humble/include/**",
        "/usr/include/**",
        "/usr/include/pcl-1.12",
        "/usr/include/eigen3",
        "/usr/include/boost"
      ],
      "browse": {
        "databaseFilename": "${default}",
        "limitSymbolsToIncludedHeaders": false
      },
      "intelliSenseMode": "gcc-x64",
      "compilerPath": "/usr/bin/gcc",
      "cStandard": "gnu11",
      "cppStandard": "c++20"
    }
  ],
  "version": 4
}